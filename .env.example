# ========================================================
# GardenConnect - Environment Configuration Template
# Copy this file to .env or configure in system environment
# ========================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gardenconnect
DB_USER=root
DB_PASSWORD=your_secure_mysql_password
DB_POOL_SIZE=10
DB_TIMEOUT_MS=30000

# Application Configuration
APP_ENV=development
APP_PORT=8080
APP_CONTEXT_PATH=/gardenconnect
APP_SECRET_KEY=ChangeThisToAStrongRandomSecretKeyForSessionSecurity32Chars!

# File Upload Settings
UPLOAD_DIR=C:/gardenconnect/uploads
MAX_FILE_SIZE_MB=5
MAX_REQUEST_SIZE_MB=10

# System Settings Defaults
COMMUNITY_NAME=GardenConnect Community
DEFAULT_PAGE_SIZE=10
MAINTENANCE_MODE=false
